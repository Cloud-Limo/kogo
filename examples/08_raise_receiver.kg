// Spelling 2: Raise receivers, as cusoon2's rpc/ops uses them. A Raise<E>
// function calls another directly; its failure becomes the caller's.
package example

fun Raise<String>.requirePercent(value: Int?): Int {
    val n = ensureNotNull(value) { "Enter a percentage." }
    ensure(n in 0..100) { "Enter a percentage from 0 to 100." }
    return n
}

fun Raise<String>.shareFor(outside: Boolean, percent: Int?): Int? =
    if (outside) requirePercent(percent) else null

// Leaving the raise scope: either { } turns it back into a value.
fun shareOrMessage(outside: Boolean, percent: Int?): String =
    either<String, Int?> { shareFor(outside, percent) }
        .fold({ it }, { share -> "share: ${share ?: 0}" })
