// The prelude's kogo.time functions and Uuid.parseOrNull (see
// lists.kg); for Kotlin, time.kt names java.time's types kogo.time's
// and Kotlin's Uuid kogo's. An instant's seconds are clamped to
// java.time's range, so the edges reach its ends.
package builtins

import kogo.Uuid
import kogo.time.DayOfWeek
import kogo.time.Duration
import kogo.time.Instant
import kogo.time.ZoneId

fun time(f: String, s: String, t: String, x: Long, y: Long, n: Int, m: Int): String? = when (f) {
    "ofEpochSecond" -> "${Instant.ofEpochSecond(x, n.toLong())} ${Duration.ofSeconds(y, m.toLong())}"
    "isBefore" -> "${instant(x, n).isBefore(instant(y, m))} ${instant(x, n).isAfter(instant(y, m))} ${instant(x, n).isBefore(instant(x, n))}"
    "compareInstant" -> "${instant(x, n) < instant(y, m)} ${instant(x, n) <= instant(y, m)} ${instant(x, n) > instant(y, m)} ${instant(x, n) >= instant(y, m)} ${instant(x, n) < instant(x, n)} ${instant(x, n) <= instant(x, n)} ${instant(x, n) >= instant(x, n)} ${instant(x, n).compareTo(instant(y, m))} ${Instant.ofEpochSecond(x % 100000L, 7L).compareTo(Instant.ofEpochSecond(x % 100000L, n.toLong() % 1000L))} ${Instant.ofEpochSecond(x % 100000L, 999999999L) < Instant.ofEpochSecond(x % 100000L + 1L, 0L)} ${Instant.ofEpochSecond(y % 100000L, 1L) > Instant.ofEpochSecond(y % 100000L, 0L)}"
    "plusDuration" -> "${instant(x, n).plus(Duration.ofSeconds(y, m.toLong()))}"
    "minusDuration" -> "${instant(x, n).minus(Duration.ofSeconds(y, m.toLong()))}"
    "atZone" -> "${ZoneId.of(zone(n * 10 + m))} ${instant(x, n).atZone(ZoneId.of(zone(n * 10 + m)))} ${instant(x, n).atZone(ZoneId.of(zone(n * 10 + m))).toLocalDate()}"
    "plusDays" -> "${instant(x, n).atZone(ZoneId.of(zone(n * 10 + m))).toLocalDate().plusDays(y)}"
    "plusDaysMax" -> "${Instant.ofEpochSecond(31556889832694400L - 86400L * (x % 8L), 0L).atZone(ZoneId.of("UTC")).toLocalDate().plusDays(y % 60L)}"
    "offsetOf" -> "${ZoneId.of(offset(n * 10 + m))}"
    "zoneId" -> zone(n * 10 + m)
    "offsetId" -> offset(n * 10 + m)
    "zoneOf" -> "${ZoneId.of(s)} ${ZoneId.of(t)}"
    "atZoneEra" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m)))} ${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).toLocalDate()}"
    "atStartOfDay" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).toLocalDate().atStartOfDay(ZoneId.of(zone(n * 10 + m)))} ${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).toLocalDate().atStartOfDay(ZoneId.of(zone(n * 10 + m))).toInstant()}"
    "dateParts" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).toLocalDate().year} ${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).toLocalDate().monthValue} ${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).toLocalDate().dayOfMonth} ${Instant.ofEpochSecond(x % 100000000000L, 0L).atZone(ZoneId.of("UTC")).toLocalDate().year}"
    "hourMinute" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).hour} ${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).minute} ${Instant.ofEpochSecond(changeAt(m) + x % 7200L, 0L).atZone(ZoneId.of(changeZone(m))).hour}"
    "plusSeconds" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).plusSeconds(y)} ${instant(x, n).atZone(ZoneId.of(zone(n * 10 + m))).plusSeconds(y)}"
    "plusSecondsChange" -> "${Instant.ofEpochSecond(sydneyChange(m) - x % 7200L, n.toLong()).atZone(ZoneId.of("Australia/Sydney")).plusSeconds(y % 14400L)} ${Instant.ofEpochSecond(changeAt(m) - x % 7200L, 0L).atZone(ZoneId.of(changeZone(m))).plusSeconds(y % 14400L).hour}"
    "fraction" -> "${Instant.ofEpochSecond(x % 100000000000L, n.toLong() % 1000L * 1000000L)} ${Instant.ofEpochSecond(x % 100000000000L, n.toLong() % 1000L * 1000L + 1000000L)}"
    "startOfChangedDay" -> "${Instant.ofEpochSecond(changeAt(m), 0L).atZone(ZoneId.of(changeZone(m))).toLocalDate().atStartOfDay(ZoneId.of(changeZone(m)))}"
    "ofDays" -> "${Duration.ofDays(n.toLong())} ${Duration.ofDays(n.toLong()).seconds}"
    "ofDaysLong" -> "${Duration.ofDays(x).seconds}"
    "between" -> "${Duration.between(instant(x, n), instant(y, m))} ${Duration.between(instant(y, m), instant(x, n))}"
    "betweenSeconds" -> "${Duration.between(instant(x, n), instant(y, m)).seconds} ${Duration.between(instant(x, n), instant(x, n))}"
    "durationSeconds" -> "${Duration.ofSeconds(x, y).seconds} ${Duration.ofSeconds(x, m.toLong()).seconds}"
    "dayOfWeek" -> "${era(x, y, n).atZone(ZoneId.of("UTC")).toLocalDate().dayOfWeek} ${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).toLocalDate().dayOfWeek.value} ${leap(m).atZone(ZoneId.of("UTC")).toLocalDate().dayOfWeek} ${leap(m).atZone(ZoneId.of("UTC")).toLocalDate().dayOfWeek.value} ${Instant.ofEpochSecond(0L, -1L).atZone(ZoneId.of("UTC")).toLocalDate().dayOfWeek}"
    "dayOfWeekEquals" -> "${day(n)} ${day(n).value} ${day(n) == day(m)} ${day(m) == DayOfWeek.SUNDAY} ${era(x, y, n).atZone(ZoneId.of("UTC")).toLocalDate().dayOfWeek == day(m)} ${DayOfWeek.MONDAY.value} ${DayOfWeek.SUNDAY.value}"
    "nextSunday" -> "${era(x, y, n).atZone(ZoneId.of("UTC")).toLocalDate().plusDays(((13 - era(x, y, n).atZone(ZoneId.of("UTC")).toLocalDate().dayOfWeek.value) % 7 + 1).toLong()).dayOfWeek} ${leap(m).atZone(ZoneId.of("UTC")).toLocalDate().plusDays(((13 - leap(m).atZone(ZoneId.of("UTC")).toLocalDate().dayOfWeek.value) % 7 + 1).toLong())}"
    "dayOfWeekName" -> "${day(n).name} ${DayOfWeek.entries} ${DayOfWeek.valueOf("SUNDAY") == DayOfWeek.SUNDAY} ${DayOfWeek.valueOf(day(m).name) == day(m)}"
    "dayOfWeekValueOf" -> "${DayOfWeek.valueOf(s)}"
    "withFields" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).withHour((m % 24 + 24) % 24)} ${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).withMinute((n % 60 + 60) % 60)} ${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).withSecond(((y % 60L + 60L) % 60L).toInt())} ${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).withNano(((x % 1000000000L + 1000000000L) % 1000000000L).toInt())}"
    "withAll" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).withHour((m % 24 + 24) % 24).withMinute(0).withSecond(0).withNano(0)} ${era(x, y, n).atZone(ZoneId.of(changeZone(m))).withHour(23).withMinute(59).withSecond(59).withNano(999999999)} ${Instant.ofEpochSecond(changeAt(m), 0L).atZone(ZoneId.of(changeZone(m))).withHour(0)} ${Instant.ofEpochSecond(changeAt(m), 0L).atZone(ZoneId.of(changeZone(m))).withHour(0).withMinute(30)}"
    "withHourBack" -> "${Instant.ofEpochSecond(clockBack(m) - 3600L + (x % 3600L + 3600L) % 3600L, 0L).atZone(ZoneId.of(clockZone(m))).withHour(repeated(m) + (n % 3 + 3) % 3 - 1)} ${Instant.ofEpochSecond(clockBack(m) + (x % 3600L + 3600L) % 3600L, 0L).atZone(ZoneId.of(clockZone(m))).withHour(repeated(m) + (n % 3 + 3) % 3 - 1)} ${Instant.ofEpochSecond(clockBack(m) - 3600L + (x % 3600L + 3600L) % 3600L, 0L).atZone(ZoneId.of(clockZone(m))).withMinute((n % 60 + 60) % 60)} ${Instant.ofEpochSecond(clockBack(m) + (x % 3600L + 3600L) % 3600L, 0L).atZone(ZoneId.of(clockZone(m))).withSecond(7).withNano(5)} ${Instant.ofEpochSecond(clockBack(m) - 5400L, 0L).atZone(ZoneId.of(clockZone(m))).withHour(repeated(m))} ${Instant.ofEpochSecond(clockBack(m) + 10800L, 0L).atZone(ZoneId.of(clockZone(m))).withHour(repeated(m))}"
    "withHourForward" -> "${Instant.ofEpochSecond(clockForward(m) - 5400L + (x % 3600L + 3600L) % 3600L, 0L).atZone(ZoneId.of(clockZone(m))).withHour(2)} ${Instant.ofEpochSecond(clockForward(m) + 10800L + (x % 3600L + 3600L) % 3600L, n.toLong()).atZone(ZoneId.of(clockZone(m))).withHour(2)} ${Instant.ofEpochSecond(clockForward(m) - 1L, 0L).atZone(ZoneId.of(clockZone(m))).withHour(2 + (n % 2 + 2) % 2)} ${Instant.ofEpochSecond(clockForward(m) + 3600L, 0L).atZone(ZoneId.of(clockZone(m))).withHour(1 + (n % 3 + 3) % 3).withMinute(0).withSecond(0).withNano(0)}"
    "withHourAt" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).withHour(n)}"
    "withMinuteAt" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).withMinute(m * 10)}"
    "withSecondAt" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).withSecond(n * 10)}"
    "withNanoAt" -> "${era(x, y, n).atZone(ZoneId.of(zone(n * 10 + m))).withNano(m)}"
    "withHour24" -> "${era(x, y, n).atZone(ZoneId.of("UTC")).withHour(24)}"
    "withNanoBillion" -> "${era(x, y, n).atZone(ZoneId.of("UTC")).withNano(1000000000)}"
    "epochSecond" -> "${instant(x, n).epochSecond} ${Instant.ofEpochSecond(0L, -1L).epochSecond} ${Instant.ofEpochSecond(x % 100000L, y).epochSecond} ${era(x, y, n).atZone(ZoneId.of("UTC")).toInstant().epochSecond}"
    "parseOrNull" -> "${Uuid.parseOrNull(uuid(n))} ${Uuid.parseOrNull(s + uuid(m))} ${Uuid.parseOrNull("${Uuid.parseOrNull(uuid(n))}") == Uuid.parseOrNull(uuid(n))}"
    "parseOrNull32" -> "${Uuid.parseOrNull("01934f2abcde7f0189abcdef0123456" + s)}"
    else -> null
}

// Zones with a half hour, 45 minutes, a negative offset, a change at
// midnight and summer time; an unknown name, and names the tz database
// has and java.time lacks; and offsets, alone and after a prefix,
// which Kogo refuses (spec 12).
fun zone(m: Int): String =
    listOf(
        "UTC", "Australia/Sydney", "America/St_Johns", "Asia/Kolkata", "Pacific/Chatham", "Europe/Dublin", "America/Sao_Paulo",
        "Mars/Olympus", "+05:30", "GMT+1", "UTC-0", "-0930", "Z", "EST", "Factory",
    )[(m % 15 + 15) % 15]

// Days whose midnight a change of offset skips (Havana, Santiago, Sao
// Paulo) or brings twice (Havana, Tunis), at 15:00 UTC.
fun changeZone(m: Int): String =
    listOf("America/Havana", "America/Havana", "America/Santiago", "Africa/Tunis", "America/Sao_Paulo")[(m % 5 + 5) % 5]

fun changeAt(m: Int): Long =
    listOf(1647183600L, 1667746800L, 1662908400L, 243961200L, 1541343600L)[(m % 5 + 5) % 5]

// The moments Sydney's offset changes in 2026: to +10:00 at 03:00 on
// 5 April, and to +11:00 at 02:00 on 4 October.
fun sydneyChange(m: Int): Long = listOf(1775318400L, 1791043200L)[(m % 2 + 2) % 2]

// 29 February of 2000, 1904 and 1600.
fun leap(m: Int): Instant = Instant.ofEpochSecond(listOf(951782400L, -2077747200L, -11670998400L)[(m % 3 + 3) % 3], 0L)

fun day(n: Int): DayOfWeek =
    listOf(DayOfWeek.MONDAY, DayOfWeek.TUESDAY, DayOfWeek.WEDNESDAY, DayOfWeek.THURSDAY, DayOfWeek.FRIDAY, DayOfWeek.SATURDAY, DayOfWeek.SUNDAY)[(n % 7 + 7) % 7]

// Two zones whose clocks change at different hours: in 2026 Sydney's
// 02:00 to 03:00 comes twice from 5 April, at clockBack, and is skipped
// on 4 October, at clockForward; New York's 01:00 to 02:00 comes twice
// on 1 November and its 02:00 to 03:00 is skipped on 8 March.
fun clockZone(m: Int): String = listOf("Australia/Sydney", "America/New_York")[(m % 2 + 2) % 2]

fun clockBack(m: Int): Long = listOf(1775318400L, 1793512800L)[(m % 2 + 2) % 2]

fun clockForward(m: Int): Long = listOf(1791043200L, 1772953200L)[(m % 2 + 2) % 2]

fun repeated(m: Int): Int = listOf(2, 1)[(m % 2 + 2) % 2]

// Offsets, which Kogo refuses (spec 12), in each form ZoneOffset.of
// reads and malformed, with characters of one UTF-16 unit and two.
fun offset(n: Int): String =
    listOf(
        "+1", "+19", "-18:01", "+18:00:01", "+05:60", "+05:30:60", "+0530x", "+05:3x", "+05_30", "+053015", "-09:30:15",
        "+é", "+1é", "+é5", "+😀", "GMT+x", "UT+", "UTC+05:30:15", "-1", "+05:30:1",
    )[(n % 20 + 20) % 20]

// Texts around an id: as a template writes it, in capitals, a digit
// short, a digit long, and with a letter that is not a hex digit.
fun uuid(n: Int): String =
    listOf(
        "01934f2a-bcde-7f01-89ab-cdef01234567", "01934F2A-BCDE-7F01-89AB-CDEF01234567", "01934f2a-bcde-7f01-89ab-cdef0123456",
        "01934f2a-bcde-7f01-89ab-cdef012345678", "01934f2a-bcde-7f01-89ab-cdef0123456g", "1934f2a-bcde-7f01-89ab-cdef01234567",
    )[(n % 6 + 6) % 6]

// Seconds from about 1685 to 2128, where zones change offset.
fun era(x: Long, y: Long, n: Int): Instant =
    Instant.ofEpochSecond(x % 5000000000L + y % 3L * 1000000000L - 2000000000L, n.toLong())

fun instant(seconds: Long, nanos: Int): Instant =
    Instant.ofEpochSecond(seconds.coerceAtLeast(-31557014167219200L).coerceAtMost(31556889864403199L), nanos.toLong())
