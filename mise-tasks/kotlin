#!/usr/bin/env bash
#MISE description="Compare the prelude's built-ins with Kotlin's, and check kotlinc refuses each deviation"
# kotlin/README.md says what this checks. Everything it writes is under
# kotlin/_work, which Go's ./... skips and git ignores.
set -euo pipefail
cd "$(dirname "$0")/../kotlin"
rm -rf _work && mkdir _work
go run ./cases gen builtins > _work/cases

go run ../cmd/kogo emit builtins _work
go build -tags kotlin -o _work/driver ./driver
rm -r _work/builtins # built in: gofmt -l . stays clean
_work/driver < _work/cases > _work/kogo

# Either is Arrow's: its jar, fetched once and checked.
arrow=${XDG_CACHE_HOME:-$HOME/.cache}/kogo/arrow-core-jvm-2.2.3.jar
if ! sha256sum -c --status <<<"a2d334ad01cf22cc534ff254788d1877e4df1564fd2b1101736a6c0e8d9a7a47  $arrow" 2>/dev/null; then
    mkdir -p "$(dirname "$arrow")"
    curl -fsSLo "$arrow" https://repo1.maven.org/maven2/io/arrow-kt/arrow-core-jvm/2.2.3/arrow-core-jvm-2.2.3.jar
    sha256sum -c --quiet <<<"a2d334ad01cf22cc534ff254788d1877e4df1564fd2b1101736a6c0e8d9a7a47  $arrow"
fi

# kotlinc reads only .kt: the same bytes, under that name.
for f in builtins/*.kg; do cp "$f" "_work/$(basename "$f" .kg).kt"; done
kotlinc -nowarn -cp "$arrow" _work/*.kt main.kt kogo.kt time.kt arrow.kt -d _work/kotlin.jar
kotlin -cp "_work/kotlin.jar:$arrow" MainKt _work/cases > _work/kotlin

go run ./cases diff _work/cases _work/kogo _work/kotlin

# refuses f: kotlinc must refuse the file f with an error on the line
# its first line names, "// kotlinc refuses line N", and with
# ", kogo check line M" after that, kogo check must refuse it on line M,
# or without it on line N, when kogo is set. Each file is a package.
refuses() {
    local f=$1 dir head line ours out
    dir=_work/$(basename "$(dirname "$f")")/$(basename "$f" .kg)
    mkdir -p "$dir"
    head=$(head -1 "$f")
    line=$(sed -n 's|^// kotlinc refuses line \([0-9][0-9]*\)\(, kogo check line [0-9][0-9]*\)\{0,1\}$|\1|p' <<<"$head")
    ours=$(sed -n 's|^// kotlinc refuses line [0-9]*, kogo check line \([0-9][0-9]*\)$|\1|p' <<<"$head")
    cp "$f" "$dir/$(basename "$f" .kg).kt"
    if out=$(kotlinc -nowarn "$dir"/*.kt -d "$dir" 2>&1); then
        echo "$f: kotlinc accepts it, and it must be refused" >&2
        return 1
    fi
    if [[ -z $line ]] || ! grep -qE "^$dir/[^:]*:$line:[0-9]+: error:" <<<"$out"; then
        echo "$f: kotlinc did not refuse line ${line:-?} (first line: // kotlinc refuses line N):" >&2
        echo "$out" >&2
        return 1
    fi
    [[ -n ${2:-} ]] || return 0
    cp "$f" "$dir/"
    if out=$(_work/kogoc check "$dir" 2>&1); then
        echo "$f: kogo check accepts it, and kotlinc refuses it" >&2
        return 1
    fi
    if ! grep -q "\"line\":${ours:-$line}," <<<"$out"; then
        echo "$f: kogo check did not refuse line ${ours:-$line}:" >&2
        echo "$out" >&2
        return 1
    fi
}

# Each deliberate deviation is refused by kotlinc on the line its
# file's first line names, so no Kotlin habit applies to one unnoticed.
for f in deviations/*.kg; do refuses "$f"; done
echo "deviations: kotlinc refuses all $(ls deviations/*.kg | wc -l)"

# What kotlinc refuses, kogo check refuses (spec.md 1).
go build -o _work/kogoc ../cmd/kogo
for f in refused/*.kg; do refuses "$f" kogo; done
echo "refused: kotlinc and kogo check refuse all $(ls refused/*.kg | wc -l)"
