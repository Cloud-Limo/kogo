#!/usr/bin/env bash
#MISE description="Recreate this worktree's test database (.mise.toml names it)"
set -euo pipefail
cd "$(dirname "$0")/.."
db=${KOGO_TEST_DATABASE_URL:?run it as mise run testdb}
db=${db##*/}
[[ $db =~ ^kogo_test(_[0-9]+)?$ ]] || { echo "testdb: $db is not a test database" >&2; exit 1; }
sudo -n -u postgres psql -qX -v ON_ERROR_STOP=1 -v db="$db" <<'SQL'
select 'create role kogo login password ''kogo'''
where not exists (select from pg_roles where rolname = 'kogo') \gexec
drop database if exists :"db";
create database :"db" owner kogo;
alter database :"db" set timezone = 'Pacific/Chatham';
SQL
PGPASSWORD=kogo psql -qX -v ON_ERROR_STOP=1 -h 127.0.0.1 -U kogo -d "$db" -f testdata/schema.sql
# Drop each kogo_test_NNN whose kogo-dev-NNN beside this one is gone.
for old in $(sudo -n -u postgres psql -qXAt -c "select datname from pg_database where datname ~ '^kogo_test_[0-9]+$'"); do
  [[ -d ../kogo-dev-${old#kogo_test_} ]] || sudo -n -u postgres psql -qX -c "drop database if exists $old" || echo "testdb: kept $old" >&2
done
