#!/usr/bin/env bash
#MISE description="Recreate the kogo_test database that the tests check against"
set -euo pipefail
cd "$(dirname "$0")/.."
sudo -n -u postgres psql -qX -v ON_ERROR_STOP=1 <<'SQL'
select 'create role kogo login password ''kogo'''
where not exists (select from pg_roles where rolname = 'kogo') \gexec
drop database if exists kogo_test;
create database kogo_test owner kogo;
SQL
PGPASSWORD=kogo psql -qX -v ON_ERROR_STOP=1 -h 127.0.0.1 -U kogo -d kogo_test -f testdata/schema.sql
