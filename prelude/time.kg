// Time, with no default zone: every conversion names its zone.
package kogo.time

external class Clock
external class Instant
external class LocalDate
external class ZoneId
external class ZonedDateTime

external object ZoneId {
    fun of(name: String): ZoneId
}

external fun Clock.now(): Instant
external fun Instant.atZone(zone: ZoneId): ZonedDateTime
external fun ZonedDateTime.toLocalDate(): LocalDate
external fun LocalDate.plusDays(daysToAdd: Long): LocalDate
