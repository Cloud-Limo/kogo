(FunDecl receipt [(Param order (NamedType String)) (Param to (NamedType Address)) (Param now (NamedType Instant)) (Param file (NamedType ByteArray))] (NamedType Mail) (Call (Ident Mail) [(Arg (StringLit [(Literal String receipt-) (Ident order) (Literal String @shop.example)])) (Arg (Ident now)) (Arg (Call (Ident Address) [(Arg (StringLit [(Literal String Shop)])) (Arg (StringLit [(Literal String shop@shop.example)]))])) (Arg (Literal Null null)) (Arg (Call (Ident listOf) [(Arg (Ident to))])) (Arg (Call (Ident emptyList))) (Arg (Call (Ident emptyList))) (Arg (StringLit [(Literal String "Your receipt for ") (Ident order)])) (Arg (StringLit [(Literal String "Thank you.\n")])) (Arg (StringLit [(Literal String "<p>Thank you.</p>")])) (Arg (Call (Ident listOf) [(Arg (Call (Ident Attachment) [(Arg (StringLit [(Literal String receipt-) (Ident order) (Literal String .txt)])) (Arg (StringLit [(Literal String text/plain)])) (Arg (Ident file))]))]))]))
(FunDecl queue [(Param tx (NamedType Tx)) (Param id (NamedType Uuid)) (Param mail (NamedType Mail))] (NamedType Int) (Call (Select (Ident tx) execute) [(Arg (SQL execute "insert into letter (id, eml) values ($id, ${eml(mail)})" [(SQLParam id (Ident id)) (SQLParam (Call (Ident eml) [(Arg (Ident mail))]))]))]))
(FunDecl queued [(Param tx (NamedType Tx)) (Param id (NamedType Uuid))] (NamedType ByteArray Nullable) (Call (Select (Ident tx) queryOne) [(NamedType ByteArray)] [(Arg (SQL queryOne "select eml from letter where id = $id" [(SQLParam id (Ident id))]))]))
