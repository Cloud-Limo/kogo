// kotlin.test's assertions, for test files (spec.md 12). Each
// panics with Kotlin's message when it fails.
package kotlin.test

external fun <T> assertEquals(expected: T, actual: T, message: String? = null)
external fun <T> assertNotEquals(illegal: T, actual: T, message: String? = null)
external fun assertTrue(actual: Boolean, message: String? = null)
external fun assertFalse(actual: Boolean, message: String? = null)
external fun <T> assertNull(actual: T?, message: String? = null)
external fun <T> assertContains(iterable: List<T>, element: T, message: String? = null)
external fun assertContains(charSequence: String, other: String, message: String? = null)
external fun fail(message: String? = null): Nothing
