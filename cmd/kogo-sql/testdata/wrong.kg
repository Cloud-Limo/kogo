// Five statements Postgres rejects.
package wrong

fun misspeltColumn(tx: Tx, id: Uuid): String? =
    tx.queryOne<String>(sql"select legal_nam from business where id = $id")

fun mistypedComparison(tx: Tx): List<Uuid> =
    tx.query<Uuid>(sql"""
        select id from business
        where legal_name = 42
    """)

fun unknownEnumLabel(tx: Tx): Long =
    tx.querySingle<Long>(sql"""select count(*) as "n!" from invoice where status = 'payed'""")

fun mismatchedJoin(tx: Tx, personId: Uuid): List<Uuid> =
    tx.query<Uuid>(sql"""
        select b.id
        from business b
        join admin_grant g on g.person_id = $personId and g.business_id = b.slug
    """)

fun lessThanNumber(tx: Tx): List<Uuid> =
    tx.query<Uuid>(sql"select id from business where legal_name < 42")

// Not literals: tx.execute(sql"delete from nowhere") in a comment,
val inString = "tx.execute(sql\"delete from nowhere\")"

// and a quote that ends a longer word.
val dialect = "postgresql"
