// The prelude's list functions, in a source that Kotlin compiles too
// (kotlin/README.md). Each branch is one case: its name, then what the
// two compilers must agree on, written as a template writes it.
package builtins

fun lists(f: String, xs: List<Long>, ys: List<Long>, n: Int, m: Int): String? = when (f) {
    "listOf" -> "${listOf(xs.size, n, m)} ${listOf<Long>()} ${emptyList<Long>()}"
    "listOfNotNull" -> "${listOfNotNull(xs.firstOrNull(), ys.lastOrNull(), xs.singleOrNull())}"
    "size" -> "${xs.size} ${xs.isNotEmpty()}"
    "none" -> "${xs.none { it > n }} ${ys.none { it % 2L == 0L }}"
    "listContains" -> "${xs.firstOrNull()?.let { ys.contains(it) }} ${ys.lastOrNull()?.let { it in xs }}"
    "get" -> "${xs[n]}"
    "first" -> "${xs.first()}"
    "firstOrNull" -> "${xs.firstOrNull()}"
    "firstOrNullWhere" -> "${xs.firstOrNull { it > n }} ${ys.firstOrNull { it % 2L == 0L }}"
    "last" -> "${xs.last()}"
    "lastOrNull" -> "${xs.lastOrNull()}"
    "single" -> "${xs.single()}"
    "singleOrNull" -> "${xs.singleOrNull()}"
    "take" -> "${xs.take(n)}"
    "drop" -> "${xs.drop(n)}"
    "forEach" -> forEach(xs)
    "toSet" -> "${xs.toSet()} ${xs.toSet() == ys.toSet()}"
    "setOf" -> "${setOf(n, m, n)} ${setOf(n, m).contains(xs.size)} ${n in setOf(m)}"
    "filter" -> "${xs.filter { it > n }}"
    "map" -> "${xs.map { it * m }}"
    "mapIndexed" -> "${xs.mapIndexed { i, x -> x - i }}"
    "zip" -> "${xs.zip(ys)}"
    "joinToString" -> xs.map { "<$it>" }.joinToString(",") + " " + ys.map { "$it" }.joinToString() + " " + listOf<String>().joinToString("-")
    "joinToStringBy" -> xs.joinToString("; ") { "${it * m}" } + " " + ys.joinToString { if (it > n) "big" else "$it" }
    "sum" -> "${xs.sum()}"
    "sumOfInt" -> "${xs.sumOf { if (it > 0L) n else m }}"
    "sumOfLong" -> "${xs.sumOf { it * it }}"
    "plus" -> "${xs + ys} ${ys.plus(xs)}"
    "count" -> "${xs.count { it > n }} ${ys.count { it % 2L == 0L }} ${listOf<Long>().count { true }} ${(xs + ys).count { it in xs }}"
    "setSize" -> "${xs.toSet().size} ${setOf(n, n).size} ${(xs + xs).toSet().size} ${setOf<Long>().size} ${xs.toSet().isEmpty()} ${setOf<Long>().isEmpty()} ${setOf(n, n).isEmpty()} ${ys.toSet().isNotEmpty()} ${setOf<Long>().isNotEmpty()}"
    "to" -> "${n to xs}"
    "isEmpty" -> "${xs.isEmpty()} ${ys.isEmpty()} ${listOf<Long>().isEmpty()}"
    "mapNotNull" -> "${xs.mapNotNull { if (it > n) it * m else null }} ${(xs + ys).toSet().mapNotNull { x -> x.takeIf { it % 2L == 0L } }}"
    "sortedBy" -> "${xs.sortedBy { it % 3L }} ${ys.sortedBy { "$it" }} ${(xs + ys).sortedBy { if (it > n) null else -it }} ${xs.sortedBy { it > m }}"
    "hSortCalls" -> sortCalls(xs + ys) // kept: spec 12, the selector's calls
    "sortedByDouble" -> "${(xs + ys).sortedBy { it.toDouble() / n.toLong().toDouble() }} ${(xs + ys).map { it.toDouble() / m.toLong().toDouble() }.sortedBy { -it }}"
    "distinctBy" -> "${xs.distinctBy { it % 3L }} ${(xs + ys).distinctBy { it > n }} ${ys.distinctBy { if (it > m) null else it / 2L }}"
    "reversed" -> "${xs.reversed()} ${xs.take(1).reversed()} ${xs.reversed() + ys} $xs"
    "groupBy" -> "${xs.groupBy { it % 3L }} ${(xs + ys).groupBy { it > n }[true]} ${xs.groupBy { it % 3L }[ys.firstOrNull() ?: 0L]}"
    "groupByEquals" -> "${listOf(n, m).groupBy { it } == listOf(m, n).groupBy { it }} ${xs.groupBy { it > n } == ys.groupBy { it > n }} ${xs.groupBy { it }}"
    "all" -> "${xs.all { it > n }} ${ys.all { it % 2L == 0L }} ${listOf<Long>().all { false }}"
    "getOrNull" -> "${xs.getOrNull(n)} ${xs.getOrNull(-1)} ${xs.getOrNull(xs.size)} ${xs.getOrNull(xs.size - 1)} ${ys.getOrNull(m)}"
    "distinct" -> "${xs.distinct()} ${(xs + ys).distinct()} ${(xs + ys).map { it % 3L }.distinct()} ${listOf<Long>().distinct()}"
    "flatMap" -> "${xs.flatMap { listOf(it, it * m) }} ${xs.flatMap { x -> ys.filter { it > x } }} ${ys.flatMap { listOf<Long>() }}"
    "maxOrNull" -> "${xs.maxOrNull()} ${(xs + ys).maxOrNull()} ${listOf<Long>().maxOrNull()} ${xs.map { it.toInt() + n }.maxOrNull()} ${xs.map { it > n }.maxOrNull()} ${ys.map { "$it" }.maxOrNull()}"
    "minOrNull" -> "${xs.minOrNull()} ${(xs + ys).minOrNull()} ${listOf<Long>().minOrNull()} ${xs.map { it.toInt() + n }.minOrNull()} ${xs.map { it > n }.minOrNull()} ${ys.map { "$it" }.minOrNull()}"
    "sortedByDescending" -> "${xs.sortedByDescending { it % 3L }} ${ys.sortedByDescending { "$it" }} ${(xs + ys).sortedByDescending { if (it > n) null else -it }} ${xs.sortedByDescending { it > m }}"
    "sortedByDescendingDouble" -> "${(xs + ys).sortedByDescending { it.toDouble() / n.toLong().toDouble() }} ${(xs + ys).map { it.toDouble() / m.toLong().toDouble() }.sortedByDescending { -it }}"
    "associateBy" -> "${xs.associateBy { it % 3L }} ${(xs + ys).associateBy { it > n }} ${ys.associateBy { if (it > m) null else it / 2L }} ${xs.associateBy { it % 3L }[ys.firstOrNull() ?: 0L]}"
    "associate" -> "${xs.associate { it % 3L to it * m }} ${(xs + ys).associate { "$it" to (it > n) }} ${listOf<Long>().associate { it to it }} ${xs.associate { it to it } == xs.reversed().associate { it to it }}"
    "keys" -> keys(xs, ys, n)
    "pair" -> "${(n to xs).first} ${(n to xs).second} ${xs.zip(ys).map { it.first - it.second }} ${(xs to ys.zip(xs)).second.map { it.second }}"
    "setPlus" -> "${xs.toSet() + n.toLong()} ${xs.toSet() + ys} ${xs.toSet() + ys.toSet()} ${setOf<Long>() + xs} ${xs.toSet() + xs} ${xs.toSet() + ys == ys.toSet() + xs}"
    "setMinus" -> "${xs.toSet() - n.toLong()} ${xs.toSet() - ys} ${xs.toSet() - ys.toSet()} ${xs.toSet() - listOf<Long>()} ${setOf<Long>() - xs} ${(xs + ys).toSet() - xs - ys}"
    "setNoneAll" -> "${setOf(1, 2).none { it > 2 }} ${setOf<Long>().none { it > 0L }} ${xs.toSet().none { it > n }} ${setOf<Long>().all { it > 0L }} ${ys.toSet().all { it % 2L == 0L }}"
    "notIn" -> "${3 !in setOf(1, 2)} ${n.toLong() !in xs.toSet()} ${m.toLong() !in ys} ${n !in 0..m} ${n !in 0 until m} ${xs.size !in 1..2 == n.toLong() !in xs}"
    "setInPlusMinus" -> "${n.toLong() in xs.toSet() + ys} ${m.toLong() in (xs + ys).toSet() - ys} ${xs.toSet() - n.toLong() + n.toLong()}"
    "takePlus" -> takePlus(xs, ys, n, m)
    "dropMap" -> "${xs.drop(n).map { it + 1L }} ${xs.drop(n).take(m)} $xs"
    "takeDropPlus" -> "${xs.take(n).drop(m) + ys.drop(m).take(n)} $xs $ys"
    "filterPlusTake" -> "${(xs.filter { it != 0L } + ys).take(n) + xs}"
    "zipTakeDrop" -> "${xs.take(n).zip(xs.drop(n))} ${ys.zip(ys.map { it.toDouble() }).drop(m)}"
    "mapPlusFirst" -> "${(xs.map { it / 2L } + xs).first()} ${(ys.take(m) + xs.drop(n)).lastOrNull()}"
    "siblings" -> siblings(xs, ys)
    "grow" -> grow(xs, ys, n)
    else -> null
}

fun forEach(xs: List<Long>): String {
    var seen = ""
    xs.forEach { seen = "$seen<$it>" }
    return seen
}

// A take shares its list's storage in Kogo: a plus on one must leave
// the list, and an earlier plus on the same take, as they were.
fun takePlus(xs: List<Long>, ys: List<Long>, n: Int, m: Int): String {
    val head = xs.take(n)
    val a = head + ys
    val b = head + xs.drop(m)
    return "$head $a $b $xs"
}

// A map's keys, and a set made from them, leave the map as it was.
fun keys(xs: List<Long>, ys: List<Long>, n: Int): String {
    val m = xs.groupBy { it % 3L }
    val more = m.keys + ys
    val less = m.keys - xs.take(n)
    return "${m.keys} $more $less $m ${m.keys == ys.groupBy { it % 3L }.keys} ${xs.associateBy { it > n }.keys}"
}

// Two lists built from one must not share what each added.
fun siblings(xs: List<Long>, ys: List<Long>): String {
    val base = xs + ys
    val a = base + listOf(1L)
    val b = base + listOf(2L, 3L)
    return "$a $b $base"
}

// A list built one element at a time, each stage kept.
fun grow(xs: List<Long>, ys: List<Long>, n: Int): String {
    var all = xs.take(n)
    var stages = listOf(all)
    for (y in ys) {
        all = all + listOf(y)
        stages = stages + listOf(all)
    }
    return "$stages"
}

fun sortCalls(xs: List<Long>): String {
    var log = ""
    val sorted = xs.sortedBy {
        log += "$it "
        it % 3L
    }
    return "$sorted $log"
}
