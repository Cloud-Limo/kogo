// Converting the error type between layers: mapLeft, then bind.
package example

sealed interface StoreError {
    data object Missing : StoreError
}

fun load(id: Int): Either<StoreError, String> =
    if (id == 1) "one".right() else StoreError.Missing.left()

fun title(id: Int): Either<String, String> = either {
    val a = load(id).mapLeft { "No item $id." }.bind()
    // Several calls converted at once: a block of the inner error type.
    val b = either<StoreError, String> { "${load(id + 1).bind()}, ${load(id + 2).bind()}" }
        .mapLeft { "No items after $id." }
        .bind()
    "$a and $b"
}
