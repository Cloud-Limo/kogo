// The prelude's string, Char and Regex functions (see lists.kg).
package builtins

fun strings(f: String, s: String, t: String, n: Int, m: Int): String? = when (f) {
    "length" -> "${s.length} ${s.isNotEmpty()}"
    "stringPlus" -> "${s + t} ${(s + t).length} ${s.plus(t) == t.plus(s)}"
    "trim" -> "<${s.trim()}>"
    "trimChar" -> "${t.map { s.trim(it) }}"
    "isBlank" -> "${s.isBlank()} ${s.isNotBlank()}"
    "isNullOrBlank" -> "${s.takeIf { n > m }.isNullOrBlank()} ${t.takeIf { n <= m }.isNullOrBlank()}"
    "ifEmpty" -> s.ifEmpty { t }
    "ifBlank" -> s.ifBlank { t }
    "substringAfter" -> "<${s.substringAfter(t)}> <${(s + t + s).substringAfter(t)}>"
    "stringTake" -> "<${s.take(n)}>"
    "trimEnd" -> "<${s.trimEnd()}>"
    "error" -> if (n > m) error(s + t) else s
    "startsWith" -> "${s.startsWith(t)} ${(t + s).startsWith(t)}"
    "endsWith" -> "${s.endsWith(t)} ${(s + t).endsWith(t)}"
    "contains" -> "${s.contains(t)} ${(s + t + s).contains(t)}"
    "containsChar" -> "${t.map { s.contains(it) }} ${s.map { (t + s).contains(it) }}"
    "lowercase" -> s.lowercase()
    "filterNot" -> s.filterNot { it.isWhitespace() }
    "filterNotIn" -> s.filterNot { t.map { c -> c }.toSet().contains(it) }
    "substringFrom" -> s.substring(n)
    "substring" -> s.substring(n, m)
    "stringMap" -> "${s.map { it }} ${s.map { it.isWhitespace() }}"
    "digitToInt" -> "${s.map { it.digitToInt() }}"
    "matches" -> "${Regex("[a-z ]*").matches(s)} ${Regex("a|.b").matches(s)}"
    "replace" -> (s + "bc").replace(Regex("(b+)|(?<c>c)"), t)
    "trimSubstring" -> "<${s.trim().substring(n).trim('a')}>"
    "substringPlus" -> s.substring(0, n) + t + s.substring(n)
    "lowercaseContains" -> "${s.lowercase().contains(t.lowercase())} ${(s + t).lowercase()}"
    "split" -> "${s.split(t)} ${(t + s + t).split(t)} ${s.split(t).size}"
    "padStart" -> "<${s.padStart(n % 9)}> ${t.map { s.padStart(m % 9, it) }}"
    "toIntOrNull" -> "${s.toIntOrNull()} ${"$n".toIntOrNull()} ${"${n}0".toIntOrNull()} ${"+$m".toIntOrNull()} ${"$t$n".toIntOrNull()}"
    "toLongOrNull" -> "${s.toLongOrNull()} ${"$n$m".toLongOrNull()} ${"${n}0000000000".toLongOrNull()} ${"-$m$n$m".toLongOrNull()}"
    else -> null
}
