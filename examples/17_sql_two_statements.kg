// A choice of statement is an if/else over two literals: no fragments.
package example

data class Invoice(val id: Uuid, val number: String, val totalCents: Long?)

fun invoice(tx: Tx, id: Uuid, forUpdate: Boolean): Invoice? =
    if (forUpdate)
        tx.queryOne<Invoice>(sql"select id, number, total_cents from invoice where id = $id for update")
    else
        tx.queryOne<Invoice>(sql"select id, number, total_cents from invoice where id = $id")

// count(*) is never null, so it fills a Long with no "n!"; a sum would need one.
fun paidCount(tx: Tx): Long =
    tx.querySingle<Long>(sql"""select count(*) as n from invoice where status = 'paid'""")
