// Gates (spec.md 15.1, 15.2, 15.7; doc/gates.md): a list names its
// check, and each row its gate or says ungated. A gate finds out who
// is asking and answers a call: the transaction, in a plain property,
// and who asked. The work is a plain fun handed the call. Its first
// line is a step, which turns the number in the input into a held
// value, and a model function that changes an invoice takes the held
// value, so the step cannot be left out. In a program each part below
// is a file, named above it; an example is one file, so here private
// and the marker hold nothing apart.
@file:OptIn(DeskOnly::class)

package example.gates

import kogo.io.Console
import kogo.rpc.Request

// api.kg: who may call each operation, in a word.
api desk checkedBy fromOurPage {
    statusOf    gatedBy atDesk
    unpaid      gatedBy atDesk
    markPaid    gatedBy atDesk
    sendInvoice gatedBy atDesk
    testPrinter gatedBy mayPrint    // an action fun: its gate answers facts alone
    looks       ungated
}

api hooks unchecked {
    forgetLooks ungated
}

data class DeskEnv(val printer: String, val console: Console)

data class InvoiceRef(val number: String)

data class Sent(val number: String, val printer: String)

// The check runs before every row of desk, looks included.
fun fromOurPage(tx: Tx, env: DeskEnv, request: Request): Either<String, Unit> = either {
    ensure(request.cookie("desk") != null) { "Open the desk's page first." }
}

// call.kg: the one file that makes a call. private is the file, and
// covers copy, so a DeskCall means that atDesk ran in this transaction
// and found a clerk.
data class Clerk private constructor(val address: String)

data class DeskCall private constructor(val tx: SerializableTx, val clerk: Clerk)

fun atDesk(tx: SerializableTx, env: DeskEnv, request: Request): Either<String, DeskCall> = either {
    val misses = tx.queryOne<Int>(sql"select count from look where address = ${request.clientAddress}") ?: 0
    ensure(misses == 0) { "This address may not use the desk." }
    DeskCall(tx, Clerk(request.clientAddress))
}

// model.kg: a held value is the permission to change one invoice. Its
// constructor is marked, and an operation's file does not opt in, so
// only a step makes one.
@RequiresOptIn
annotation class DeskOnly

data class OpenInvoice @DeskOnly constructor(val number: String, val totalCents: Long)

// The parameter is the held value and never a number: this is what
// makes the work's first line impossible to leave out.
fun setStatus(tx: Tx, invoice: OpenInvoice, paid: Boolean): Boolean =
    tx.execute(sql"""
        update invoice set status = case when $paid then 'paid' else 'sent' end::invoice_status
        where number = ${invoice.number}
    """) == 1

// Reads that anyone at the desk may make take the transaction alone.
fun invoiceStatus(tx: Tx, number: String): String? =
    tx.queryOne<String>(sql"""select status::text as "status!" from invoice where number = $number""")

fun unpaidNumbers(tx: Tx): List<String> =
    tx.query<String>(sql"select number from invoice where status <> 'paid' order by number")

// steps.kg, which opts in to DeskOnly: a step takes the call and an id
// of the input, and answers the held value or refuses.
fun requireOpenInvoice(call: DeskCall, number: String): Either<String, OpenInvoice> = either {
    val total = call.tx.queryOne<Long>(sql"""
        select total_cents as "total_cents!" from invoice where number = $number and status <> 'paid' and total_cents is not null
    """) ?: raise("Invoice $number cannot be changed.")
    OpenInvoice(number, total)
}

// desk.kg, which opts in to nothing: the work takes the environment,
// the call and the input, and passes the call's transaction on.
fun statusOf(env: DeskEnv, call: DeskCall, input: InvoiceRef): Either<String, String> = either {
    invoiceStatus(call.tx, input.number) ?: raise("There is no invoice ${input.number}.")
}

fun unpaid(env: DeskEnv, call: DeskCall, input: Unit): Either<String, List<String>> = either {
    unpaidNumbers(call.tx)
}

fun markPaid(env: DeskEnv, call: DeskCall, input: InvoiceRef): Either<String, Long> = either {
    val invoice = requireOpenInvoice(call, input.number).bind()
    ensure(setStatus(call.tx, invoice, true)) { "Invoice ${invoice.number} is gone." }
    invoice.totalCents
}

fun sendInvoice(env: DeskEnv, call: DeskCall, input: InvoiceRef): Either<String, Sent> = either {
    val invoice = requireOpenInvoice(call, input.number).bind()
    ensure(setStatus(call.tx, invoice, false)) { "Invoice ${invoice.number} is gone." }
    Sent(invoice.number, env.printer)
}

// printer.kg: work that changes something outside is an action fun.
// The server ends the gate's transaction and then runs the work with
// none open, so the work is not handed a call. Its row names a gate
// that begins with atDesk and answers facts alone: a gate here that
// answered the DeskCall would be a compile error, action-gate.
data class Printing(val address: String)

fun mayPrint(tx: SerializableTx, env: DeskEnv, request: Request): Either<String, Printing> = either {
    val call = atDesk(tx, env, request).bind()
    Printing(call.clerk.address)
}

action fun testPrinter(env: DeskEnv, printing: Printing, input: Unit): Either<String, String> = either {
    ensure(env.printer != "") { "No printer is set up." }
    env.console.println("${env.printer}: a test page for ${printing.address}")
    env.printer
}

// Ungated: it takes the request and a bare transaction, and finds out
// who is asking itself.
fun looks(tx: Tx, env: DeskEnv, request: Request, input: Unit): Either<String, Int> = either {
    tx.queryOne<Int>(sql"select count from look where address = ${request.clientAddress}") ?: 0
}

fun forgetLooks(tx: Tx, env: DeskEnv, request: Request, input: Unit): Either<String, Unit> = either {
    tx.execute(sql"delete from look where address = ${request.clientAddress}")
}
