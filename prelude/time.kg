// Time, with no default zone: every conversion names its zone.
package kogo.time

external class Clock
external class Instant
external class LocalDate
external class LocalTime
external class Duration
external class ZoneId
external class ZonedDateTime

external object ZoneId {
    fun of(name: String): ZoneId
}

external fun Clock.now(): Instant
external fun Instant.atZone(zone: ZoneId): ZonedDateTime
external fun ZonedDateTime.toLocalDate(): LocalDate
external fun LocalDate.plusDays(daysToAdd: Long): LocalDate
external fun LocalDate.atStartOfDay(zone: ZoneId): ZonedDateTime
external fun ZonedDateTime.toInstant(): Instant
external fun ZonedDateTime.plusSeconds(seconds: Long): ZonedDateTime

external object Instant {
    fun ofEpochSecond(epochSecond: Long, nanoAdjustment: Long): Instant
}

external object Duration {
    fun ofSeconds(seconds: Long, nanoAdjustment: Long): Duration
    fun ofDays(days: Long): Duration
    fun between(startInclusive: Instant, endExclusive: Instant): Duration
}

external val Duration.seconds: Long

external fun Instant.isBefore(otherInstant: Instant): Boolean
external fun Instant.isAfter(otherInstant: Instant): Boolean
external fun Instant.compareTo(other: Instant): Int
external fun Instant.plus(amountToAdd: Duration): Instant
external fun Instant.minus(amountToSubtract: Duration): Instant

external val LocalDate.year: Int
external val LocalDate.monthValue: Int
external val LocalDate.dayOfMonth: Int
external val ZonedDateTime.hour: Int
external val ZonedDateTime.minute: Int
